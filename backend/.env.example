# =======================================================
# Inclura Fortress Security Engine (IFSE)
# Identity Backend Environment Configuration
# =======================================================

# =======================================================
# Server
# =======================================================

NODE_ENV=development

PORT=5000

# =======================================================
# Firebase Admin
# =======================================================

FIREBASE_PROJECT_ID=

FIREBASE_CLIENT_EMAIL=

FIREBASE_PRIVATE_KEY=

# =======================================================
# WebAuthn / Passkeys
# =======================================================

WEBAUTHN_RP_NAME=Inclura

WEBAUTHN_RP_ID=localhost

WEBAUTHN_ORIGIN=http://localhost:5173

# =======================================================
# Security
# =======================================================

JWT_SECRET=

SESSION_SECRET=

ENCRYPTION_SECRET=

# =======================================================
# Logging
# =======================================================

LOG_LEVEL=info

# =======================================================
# Render
# =======================================================

RENDER_EXTERNAL_URL=

# =======================================================
# CORS (comma separated browser origins allowed to call this API)
# =======================================================

CORS_ORIGINS=https://inclura-web.pages.dev,http://localhost:5173

# =======================================================
# SOS SMS PROVIDER
# SMS_PROVIDER = twilio | termii | webhook | none
# Configure ONE provider. Leave empty to disable SMS only.
# =======================================================

SMS_PROVIDER=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Termii
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com

# Generic SMS webhook (accepts { channel, to, body })
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# =======================================================
# SOS EMAIL PROVIDER
# EMAIL_PROVIDER = resend | sendgrid | webhook | none
# =======================================================

EMAIL_PROVIDER=

RESEND_API_KEY=
SENDGRID_API_KEY=

# Verified sender, e.g. "Inclura Emergency <alerts@yourdomain.com>"
EMAIL_FROM=

EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# =======================================================
# SOS RECIPIENTS
# Comma separated. Emergency numbers/emails are ALWAYS
# notified on every SOS, in addition to trusted contacts.
# =======================================================

EMERGENCY_SMS_NUMBERS=
EMERGENCY_EMAILS=

# Administrator copy of every SOS (status + addresses involved)
ADMIN_NOTIFICATION_PHONES=
ADMIN_NOTIFICATION_EMAILS=

# Verification only. The test endpoint never sends to the
# real emergency or admin recipients above.
EMERGENCY_TEST_PHONES=
EMERGENCY_TEST_EMAILS=

# =======================================================
# SOS NOTIFICATION SWEEPER (server-side retry safety net)
# =======================================================

SOS_SWEEP_ENABLED=true
SOS_SWEEP_INTERVAL_MS=60000
