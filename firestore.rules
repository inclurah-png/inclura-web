rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Feed posts must remain readable by authenticated Inclura members.
    match /posts/{postId} {
      allow read: if request.auth != null;
    }

    // Comments are stored under each post.
    match /posts/{postId}/comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000;
      allow update, delete: if false;
    }

    // Private one-to-one conversations: only listed participants may access them.
    match /chats/{chatId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.createdBy == request.auth.uid;

      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly([
                         'typing',
                         'typingUser',
                         'participantNames',
                         'participantProfiles',
                         'updatedAt',
                         'lastMessage',
                         'lastSenderId'
                       ]);

      allow delete: if false;

      match /messages/{messageId} {
        function isChatParticipant() {
          return request.auth != null
                 && request.auth.uid in
                    get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }

        function hasValidMessageContent() {
          return (
            request.resource.data.messageType == 'text'
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 10000
          ) || (
            request.resource.data.messageType == 'image'
            && request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.size() > 0
          ) || (
            request.resource.data.messageType == 'video'
            && request.resource.data.videoUrl is string
            && request.resource.data.videoUrl.size() > 0
          ) || (
            request.resource.data.messageType == 'file'
            && request.resource.data.fileUrl is string
            && request.resource.data.fileUrl.size() > 0
          ) || (
            request.resource.data.messageType == 'audio'
            && request.resource.data.audioUrl is string
            && request.resource.data.audioUrl.size() > 0
          );
        }

        allow read: if isChatParticipant();

        // Supports text, image, video, document/file, and voice-note messages.
        // Only the sender can create a message inside a chat they belong to.
        allow create: if isChatParticipant()
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.readBy is list
                      && request.auth.uid in request.resource.data.readBy
                      && request.resource.data.status == 'sent'
                      && request.resource.data.createdAt is timestamp
                      && request.resource.data.messageType in [
                        'text', 'image', 'video', 'file', 'audio'
                      ]
                      && hasValidMessageContent()
                      && request.resource.data.keys().hasOnly([
                        'text',
                        'senderId',
                        'createdAt',
                        'status',
                        'readBy',
                        'messageType',
                        'imageUrl',
                        'videoUrl',
                        'fileUrl',
                        'audioUrl',
                        'fileName',
                        'fileType',
                        'fileSize'
                      ])
                      && (
                        !('fileSize' in request.resource.data)
                        || (
                          request.resource.data.fileSize is int
                          && request.resource.data.fileSize >= 0
                          && request.resource.data.fileSize <= 52428800
                        )
                      );

        // Participants may update read receipts, and may add translation
        // text without changing the original message or its sender.
        allow update: if isChatParticipant()
                      && request.resource.data.senderId == resource.data.senderId
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'readBy', 'translatedText'])
                      && (
                        (
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status', 'readBy'])
                          && resource.data.senderId != request.auth.uid
                          && request.resource.data.readBy is list
                          && request.auth.uid in request.resource.data.readBy
                          && request.resource.data.status == 'read'
                        )
                        || (
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['translatedText'])
                          && request.resource.data.translatedText is map
                        )
                      );

        allow delete: if false;
      }
    }

    // Members may update only their own accessibility preferences.
    match /users/{userId} {
      // A signed-in member may read their own private profile document.
      // This is required by the publication Follow button to load the member's following list.
      allow get: if request.auth != null && request.auth.uid == userId;

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly([
                         'language',
                         'preferredLanguage',
                         'fontScale',
                         'highContrast',
                         'reducedMotion',
                         'voiceEnabled',
                         'accessibilityNeeds'
                       ]);
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null
                  && resource.data.receiverId == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.receiverId == request.auth.uid
                    && request.resource.data.receiverId == resource.data.receiverId
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['read']);

      allow create: if request.auth != null
                    && request.resource.data.receiverId is string
                    && (
                      request.resource.data.senderId == request.auth.uid
                      || (
                        request.resource.data.senderId == 'system'
                        && request.resource.data.receiverId == request.auth.uid
                      )
                    );

      allow delete: if false;
    }
  }
}
