rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Email ownership must be confirmed before an account can publish or contact members.
    function isVerifiedMember() {
      return isActiveAccount()
        && request.auth.token.email_verified == true
        && isActiveAccount();
    }

    function isVerifiedAdmin() {
      return isActiveAccount()
        && request.auth.token.admin == true
        && request.auth.token.email_verified == true
        && isActiveAccount();
    }

    function hasNoServerManagedPartnershipFields() {
      return !('contractDocument' in request.resource.data)
        && !('contractVerificationStatus' in request.resource.data)
        && !('contractReviewedBy' in request.resource.data)
        && !('contractReviewedAt' in request.resource.data)
        && !('paymentRequired' in request.resource.data)
        && !('paymentStatus' in request.resource.data)
        && !('paymentVerifiedAt' in request.resource.data)
        && !('paymentVerifiedBy' in request.resource.data)
        && !('finalApprovals' in request.resource.data)
        && !('finalApprovedBy' in request.resource.data)
        && !('finalApprovedAt' in request.resource.data)
        && !('activatedBy' in request.resource.data)
        && !('activatedAt' in request.resource.data)
        && !('paymentRequirementReviewedBy' in request.resource.data)
        && !('paymentRequirementReviewedAt' in request.resource.data)
        && !('finalApprovalNotes' in request.resource.data)
        && !('contractReviewNotes' in request.resource.data);
    }

    function isActiveAccount() {
      return request.auth != null
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active'
        );
    }

    // Public share snapshots contain only creator-approved display fields.
    // Anonymous visitors may fetch one active document by ID; collection listing is forbidden.
    match /publicSharedPosts/{postId} {
      // Owners may inspect their own snapshot, including an inactive one or a not-yet-created ID.
      // Anonymous visitors may fetch only active snapshots; collection listing stays forbidden.
      allow get: if resource == null
                 || resource.data.active == true
                 || (isActiveAccount() && resource.data.ownerId == request.auth.uid);
      allow list: if false;

      allow create: if isActiveAccount()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.sourcePostId == postId
                    && get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid
                    && request.resource.data.userName == get(/databases/$(database)/documents/posts/$(postId)).data.userName
                    && request.resource.data.text == get(/databases/$(database)/documents/posts/$(postId)).data.text
                    && request.resource.data.imageUrl == get(/databases/$(database)/documents/posts/$(postId)).data.imageUrl
                    && request.resource.data.videoUrl == get(/databases/$(database)/documents/posts/$(postId)).data.videoUrl
                    && request.resource.data.userName is string
                    && request.resource.data.userName.size() <= 100
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 10000
                    && request.resource.data.imageUrl is string
                    && request.resource.data.videoUrl is string
                    && request.resource.data.imageAlt is string
                    && request.resource.data.imageAlt.size() <= 300
                    && request.resource.data.active == true
                    && request.resource.data.sharedAt is timestamp
                    && request.resource.data.keys().hasOnly([
                      'ownerId', 'sourcePostId', 'userName', 'text',
                      'imageUrl', 'videoUrl', 'imageAlt', 'active', 'sharedAt'
                    ])
                    && (
                      request.resource.data.imageUrl == ''
                      || request.resource.data.imageUrl.matches('https://res\\.cloudinary\\.com/.*')
                    )
                    && (
                      request.resource.data.videoUrl == ''
                      || request.resource.data.videoUrl.matches('https://res\\.cloudinary\\.com/.*')
                    )
                    && !(
                      request.resource.data.imageUrl.size() > 0
                      && request.resource.data.videoUrl.size() > 0
                    );

      // The owner may activate/revoke the snapshot and replace its original
      // media URL with the secure watermarked Cloudinary copy after processing.
      // All other approved display fields remain immutable.
      allow update: if isActiveAccount()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['active', 'imageUrl', 'videoUrl'])
                    && request.resource.data.active is bool
                    && request.resource.data.userName == resource.data.userName
                    && request.resource.data.text == resource.data.text
                    && request.resource.data.imageAlt == resource.data.imageAlt
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.sourcePostId == resource.data.sourcePostId
                    && request.resource.data.sharedAt == resource.data.sharedAt
                    && request.resource.data.imageUrl is string
                    && request.resource.data.videoUrl is string
                    && (
                      request.resource.data.imageUrl == ''
                      || request.resource.data.imageUrl.matches('https://res\\.cloudinary\\.com/.*')
                    )
                    && (
                      request.resource.data.videoUrl == ''
                      || request.resource.data.videoUrl.matches('https://res\\.cloudinary\\.com/.*')
                    )
                    && !(
                      request.resource.data.imageUrl.size() > 0
                      && request.resource.data.videoUrl.size() > 0
                    );
      allow delete: if false;
    }

    // Full source posts are never exposed to anonymous visitors.
    // Public links use the separate, minimal publicSharedPosts collection below.
    match /posts/{postId} {
      allow get, list: if isActiveAccount();

      // Only the post owner may enable or disable external sharing, and no other post field may change here.
      allow update: if isActiveAccount()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['externalShareEnabled'])
                    && request.resource.data.externalShareEnabled is bool;

      // Members may publish only posts under their own authenticated identity.
      // Media URLs must come from Inclura's Cloudinary upload pipeline.
      allow create: if isVerifiedMember()
                    && request.resource.data.userId == request.auth.uid
                    // Badge and subscription claims must match the server-controlled member profile.
                    && request.resource.data.verified == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('verified', false)
                    && request.resource.data.badgeType == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('badgeType', '')
                    && request.resource.data.premium == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('premium', false)
                    && request.resource.data.premiumTier == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('premiumTier', '')
                    && request.resource.data.role == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user')
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 10000
                    && request.resource.data.category is string
                    && request.resource.data.userName is string
                    && request.resource.data.imageUrl is string
                    && request.resource.data.videoUrl is string
                    && request.resource.data.imagePublicId is string
                    && request.resource.data.videoPublicId is string
                    && request.resource.data.mediaProvider is string
                    && (
                      request.resource.data.imageUrl == ''
                      || request.resource.data.imageUrl.matches('https://res\\.cloudinary\\.com/.*')
                    )
                    && (
                      request.resource.data.videoUrl == ''
                      || request.resource.data.videoUrl.matches('https://res\\.cloudinary\\.com/.*')
                    )
                    && !(
                      request.resource.data.imageUrl.size() > 0
                      && request.resource.data.videoUrl.size() > 0
                    )
                    && request.resource.data.keys().hasOnly([
                      'text', 'language', 'originalLanguage', 'translatedText',
                      'category', 'userId', 'userName', 'profilePhoto', 'role',
                      'accessibilityNeeds', 'accessibilityTags', 'verified',
                      'badgeType', 'verificationMetadata', 'premium', 'premiumTier',
                      'imageUrl', 'videoUrl', 'imagePublicId', 'videoPublicId',
                      'mediaProvider', 'likes', 'comments', 'reactions',
                      'userReactions', 'creatorScore', 'commentCount', 'crossPosts',
                      'saveCount', 'createdAt'
                    ]);
    }

    // Comments are stored under each post.
    match /posts/{postId}/comments/{commentId} {
      allow read: if isActiveAccount();
      allow create: if isVerifiedMember()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000;
      allow update, delete: if false;
    }

    // Private one-to-one conversations: only listed participants may access them.
    match /chats/{chatId} {
      // A participant may check a deterministic chat ID before creating it.
      // Existing conversations remain readable only by their two participants.
      allow get: if isActiveAccount()
                 && (resource == null
                     || request.auth.uid in resource.data.participants);
      allow list: if isActiveAccount()
                  && request.auth.uid in resource.data.participants;

      allow create: if isVerifiedMember()
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.createdBy == request.auth.uid;

      allow update: if isActiveAccount()
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly([
                         'typing',
                         'typingUser',
                         'participantNames',
                         'participantProfiles',
                         'updatedAt',
                         'lastMessage',
                         'lastSenderId'
                       ]);

      allow delete: if false;

      match /messages/{messageId} {
        function isChatParticipant() {
          return isActiveAccount()
                 && request.auth.uid in
                    get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }

        function hasValidMessageContent() {
          return (
            request.resource.data.messageType == 'text'
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 10000
          ) || (
            request.resource.data.messageType == 'image'
            && request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.size() > 0
          ) || (
            request.resource.data.messageType == 'video'
            && request.resource.data.videoUrl is string
            && request.resource.data.videoUrl.size() > 0
          ) || (
            request.resource.data.messageType == 'file'
            && request.resource.data.fileUrl is string
            && request.resource.data.fileUrl.size() > 0
          ) || (
            request.resource.data.messageType == 'audio'
            && request.resource.data.audioUrl is string
            && request.resource.data.audioUrl.size() > 0
          );
        }

        allow read: if isChatParticipant();

        // Supports text, image, video, document/file, and voice-note messages.
        // Only the sender can create a message inside a chat they belong to.
        allow create: if isVerifiedMember()
                      && isChatParticipant()
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.readBy is list
                      && request.auth.uid in request.resource.data.readBy
                      && request.resource.data.status == 'sent'
                      && request.resource.data.createdAt is timestamp
                      && request.resource.data.messageType in [
                        'text', 'image', 'video', 'file', 'audio'
                      ]
                      && hasValidMessageContent()
                      && request.resource.data.keys().hasOnly([
                        'text',
                        'senderId',
                        'createdAt',
                        'status',
                        'readBy',
                        'messageType',
                        'imageUrl',
                        'videoUrl',
                        'fileUrl',
                        'audioUrl',
                        'fileName',
                        'fileType',
                        'fileSize'
                      ])
                      && (
                        !('fileSize' in request.resource.data)
                        || (
                          request.resource.data.fileSize is int
                          && request.resource.data.fileSize >= 0
                          && request.resource.data.fileSize <= 52428800
                        )
                      );

        // Participants may update read receipts, and may add translation
        // text without changing the original message or its sender.
        allow update: if isChatParticipant()
                      && request.resource.data.senderId == resource.data.senderId
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'readBy', 'translatedText'])
                      && (
                        (
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status', 'readBy'])
                          && resource.data.senderId != request.auth.uid
                          && request.resource.data.readBy is list
                          && request.auth.uid in request.resource.data.readBy
                          && request.resource.data.status == 'read'
                        )
                        || (
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['translatedText'])
                          && request.resource.data.translatedText is map
                        )
                      );

        allow delete: if false;
      }
    }

    // Members may update only their own accessibility preferences.
    match /users/{userId} {
      // A signed-in member may read their own private profile document.
      // This is required by the publication Follow button to load the member's following list.
      allow get: if isActiveAccount() && request.auth.uid == userId;
      // Only a server-authorized administrator may enumerate private member records.
      allow list: if isActiveAccount() && isVerifiedAdmin();

      // A member may create their own profile document and update only
      // profile/accessibility fields belonging to that member.
      allow create: if isActiveAccount()
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.role == 'user'
                    && request.resource.data.verified == false
                    && request.resource.data.creatorVerified == false
                    && request.resource.data.premium == false
                    && request.resource.data.keys().hasOnly([
                      'uid',
                      'fullName',
                      'location',
                      'phoneNumber',
                      'bio',
                      'category',
                      'preferredLanguage',
                      'language',
                      'fontScale',
                      'highContrast',
                      'reducedMotion',
                      'voiceEnabled',
                      'accessibilityNeeds',
                      'accessibilityNeedsPublic',
                      'accessibility',
                      'photoURL',
                      'profilePhoto',
                      'email',
                      'createdAt',
                      'verified',
                      'badgeType',
                      'creatorVerified',
                      'creatorVerifiedAt',
                      'premium',
                      'premiumTier',
                      'role',
                      'resumeCompleted',
                      'followers',
                      'following',
                      'savedPosts',
                      'acceptedCommunityStandards',
                      'acceptedCommunityStandardsAt'
                    ])
                    && (!('acceptedCommunityStandards' in request.resource.data)
                        || request.resource.data.acceptedCommunityStandards == true)
                    && (!('acceptedCommunityStandardsAt' in request.resource.data)
                        || request.resource.data.acceptedCommunityStandardsAt is timestamp);

      allow update: if (
                      isActiveAccount()
                      && request.auth.uid == userId
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly([
                           'fullName',
                           'location',
                           'phoneNumber',
                           'bio',
                           'category',
                           'preferredLanguage',
                           'language',
                           'fontScale',
                           'highContrast',
                           'reducedMotion',
                           'voiceEnabled',
                           'accessibilityNeeds',
                           'accessibilityNeedsPublic',
                           'photoURL',
                           'profilePhoto',
                           'email',
                           'accountType',
                           'verificationCategory',
                           'interests',
                           'savedPosts',
                           'following',
                           'organizationName',
                           'website',
                           'groupName',
                           'groupDescription',
                           'groupCategory',
                           'onboardingCompleted',
                           'updatedAt'
                         ])
                      && (!('accountType' in request.resource.data)
                          || request.resource.data.accountType is string)
                      && (!('onboardingCompleted' in request.resource.data)
                          || request.resource.data.onboardingCompleted is bool)
                      && (!('interests' in request.resource.data)
                          || request.resource.data.interests is list)
                      && (!('accessibilityNeeds' in request.resource.data)
                          || request.resource.data.accessibilityNeeds is list)
                    ) || (
                      isActiveAccount()
                      && request.auth.uid != userId
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['followers'])
                      && request.resource.data.followers is list
                      && (
                        (
                          request.auth.uid in request.resource.data.followers
                          && !(request.auth.uid in resource.data.get('followers', []))
                        )
                        || (
                          !(request.auth.uid in request.resource.data.followers)
                          && request.auth.uid in resource.data.get('followers', [])
                        )
                      )
                     );
    }

    // Account moderation records are server-generated and immutable to clients.
    match /userModerationAuditLogs/{logId} {
      allow get, list: if isVerifiedAdmin();
      allow create, update, delete: if false;
    }

    // Executive analytics are private. Only a signed-in account whose own
    // profile explicitly carries role: "admin" may read the single report.
    // Client-side writes and collection listing are never permitted.
    function isIncluraAdmin() {
      // Match the server-issued Firebase Authentication admin claim used
      // by the existing Users Management page. Never trust a profile field.
      return isActiveAccount()
        && isVerifiedAdmin();
    }

    match /executiveReports/{reportId} {
      allow get: if isIncluraAdmin() && reportId == "current";
      allow list, create, update, delete: if false;
    }

    // Care requests are private to their requester until a provider workflow is implemented.
    // This allows members to create a request and read only their own requests.
    // Provider discovery, applications, assignment and status changes remain disabled.
    match /careRequests/{requestId} {
      allow create: if isActiveAccount()
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.serviceType in [
                      'caregiver', 'home_assistance', 'transportation', 'support'
                    ]
                    && request.resource.data.description is string
                    && request.resource.data.description.size() > 0
                    && request.resource.data.description.size() <= 3000
                    && request.resource.data.location is string
                    && request.resource.data.location.size() > 0
                    && request.resource.data.location.size() <= 250
                    && request.resource.data.preferredDate is string
                    && request.resource.data.preferredTime is string
                    && request.resource.data.urgency in ['low', 'normal', 'high']
                    && request.resource.data.communicationPreference in ['text', 'voice', 'video', 'any', '']
                    && request.resource.data.accessibilityNeeds is string
                    && request.resource.data.accessibilityNeeds.size() <= 1000
                    && request.resource.data.status == 'open'
                    && request.resource.data.providerId == null
                    && request.resource.data.applicationCount == 0
                    && request.resource.data.selectedProviderId == null
                    && request.resource.data.ifseVerified == false
                    && request.resource.data.ifseReviewRequired == true
                    && request.resource.data.safetyReviewStatus == 'pending'
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.updatedAt is timestamp
                    && request.resource.data.keys().hasOnly([
                      'requesterId',
                      'serviceType',
                      'description',
                      'location',
                      'preferredDate',
                      'preferredTime',
                      'urgency',
                      'communicationPreference',
                      'accessibilityNeeds',
                      'status',
                      'providerId',
                      'applicationCount',
                      'selectedProviderId',
                      'ifseVerified',
                      'ifseReviewRequired',
                      'safetyReviewStatus',
                      'createdAt',
                      'updatedAt'
                    ]);

      allow get, list: if isActiveAccount()
                       && resource.data.requesterId == request.auth.uid;

      allow update, delete: if false;
    }

    // Social connection records are private to their owner. OAuth credentials/tokens
    // must never be stored in client-readable Firestore documents; authorized backend
    // services own credential storage and publishing updates.
    match /socialConnections/{connectionId} {
      allow get, list: if isActiveAccount()
                       && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Public member directory supports discovery without exposing private users/{uid} records.
    // It intentionally excludes email, phone number and private accessibility settings.
    // Cross-post requests are private to the authenticated creator.
    // The browser may request preparation, but it can never publish externally
    // or alter watermark/XP outcomes. Those fields are reserved for an
    // authorized backend workflow.
    match /crossPostRequests/{requestId} {
      allow create: if isActiveAccount()
                    && request.resource.data.creatorId == request.auth.uid
                    && request.resource.data.sourcePostId is string
                    && request.resource.data.sourcePostId.size() > 0
                    && request.resource.data.sourcePostOwnerId == request.auth.uid
                    && exists(/databases/$(database)/documents/posts/$(request.resource.data.sourcePostId))
                    && get(/databases/$(database)/documents/posts/$(request.resource.data.sourcePostId)).data.userId == request.auth.uid
                    && request.resource.data.platforms is list
                    && request.resource.data.platforms.size() > 0
                    && request.resource.data.platforms.size() <= 8
                    && request.resource.data.platforms.hasOnly([
                      'facebook', 'instagram', 'x', 'linkedin',
                      'reddit', 'threads', 'whatsapp', 'telegram'
                    ])
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 1000
                    && request.resource.data.visibility in ['public', 'followers']
                    && request.resource.data.status == 'pending'
                    && request.resource.data.requestVersion == 2
                    && request.resource.data.security.frontendCreated == true
                    && request.resource.data.security.backendRequired == true
                    && request.resource.data.security.clientPublishingAllowed == false
                    && request.resource.data.security.clientWatermarkProcessingAllowed == false
                    && request.resource.data.watermark.required is bool
                    && request.resource.data.watermark.required == (
                      (get(/databases/$(database)/documents/posts/$(request.resource.data.sourcePostId)).data.imageUrl is string
                        && get(/databases/$(database)/documents/posts/$(request.resource.data.sourcePostId)).data.imageUrl.size() > 0)
                      || (get(/databases/$(database)/documents/posts/$(request.resource.data.sourcePostId)).data.videoUrl is string
                        && get(/databases/$(database)/documents/posts/$(request.resource.data.sourcePostId)).data.videoUrl.size() > 0)
                    )
                    && ((request.resource.data.watermark.required == true
                          && request.resource.data.watermark.status == 'pending')
                        || (request.resource.data.watermark.required == false
                          && request.resource.data.watermark.status == 'not_required'))
                    && request.resource.data.publishing.status == 'pending'
                    && request.resource.data.publishing.completed == false
                    && request.resource.data.creatorGrowth.eligible == false
                    && request.resource.data.creatorGrowth.points == 0
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.keys().hasOnly([
                      'creatorId', 'sourcePostId', 'sourcePostOwnerId',
                      'platforms', 'message', 'visibility', 'status',
                      'requestVersion', 'security', 'watermark', 'publishing',
                      'creatorGrowth', 'createdAt'
                    ]);

      allow get, list: if isActiveAccount()
                       && resource.data.creatorId == request.auth.uid;

      allow update, delete: if false;
    }

    match /memberDirectory/{memberId} {
      allow get, list: if isActiveAccount();

      function isOwnerMember() {
        return isActiveAccount() && request.auth.uid == memberId;
      }

      function hasSafeMemberFields() {
        return request.resource.data.uid == memberId
          && request.resource.data.fullName is string
          && request.resource.data.fullName.size() <= 100
          && request.resource.data.photoURL is string
          && request.resource.data.location is string
          && request.resource.data.location.size() <= 250
          && request.resource.data.category is string
          && request.resource.data.accountType is string
          && request.resource.data.bio is string
          && request.resource.data.bio.size() <= 1000
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.keys().hasOnly([
            'uid', 'fullName', 'photoURL', 'location',
            'category', 'accountType', 'bio', 'updatedAt'
          ]);
      }

      allow create, update: if isOwnerMember() && hasSafeMemberFields();
      allow delete: if false;
    }

    // Public mentor directory contains only deliberately selected profile fields.
    // Private contact details and non-public accessibility preferences stay in users/{uid}.
    match /mentorDirectory/{mentorId} {
      allow get, list: if isActiveAccount();

      function isOwnerMentor() {
        return isActiveAccount()
          && request.auth.uid == mentorId
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == "Mentor";
      }

      function hasSafeMentorFields() {
        return request.resource.data.uid == mentorId
          && request.resource.data.fullName is string
          && request.resource.data.location is string
          && request.resource.data.bio is string
          && request.resource.data.expertise is string
          && request.resource.data.photoURL is string
          && request.resource.data.accessibilityNeeds is list
          && request.resource.data.verified
             == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verified
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.keys().hasOnly([
            'uid', 'fullName', 'location', 'bio', 'expertise',
            'photoURL', 'accessibilityNeeds', 'verified', 'updatedAt'
          ]);
      }

      allow create, update: if isOwnerMentor() && hasSafeMentorFields();
      allow delete: if false;
    }

    // Opportunities are public to signed-in members. Posting requires an
    // active recruiter subscription recorded on the member's private profile.
    match /opportunities/{opportunityId} {
      allow get, list: if isActiveAccount();

      allow create: if isActiveAccount()
                    && request.resource.data.recruiterId == request.auth.uid
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.recruiter.status == 'active'
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.recruiter.plan in ['starter', 'business', 'enterprise']
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.recruiter.expiresAt is timestamp
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.recruiter.expiresAt > request.time
                    && request.resource.data.recruiterPlan
                       == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.recruiter.plan
                    && request.resource.data.featured
                       == (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.recruiter.plan != 'starter')
                    && request.resource.data.analyticsEnabled
                       == (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.recruiter.plan != 'starter')
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 150
                    && request.resource.data.company is string
                    && request.resource.data.company.size() > 0
                    && request.resource.data.company.size() <= 150
                    && request.resource.data.location is string
                    && request.resource.data.location.size() <= 200
                    && request.resource.data.employmentType in [
                      'Full Time', 'Part Time', 'Contract', 'Internship', 'Volunteer', 'Remote'
                    ]
                    && request.resource.data.salary is string
                    && request.resource.data.description is string
                    && request.resource.data.description.size() > 0
                    && request.resource.data.description.size() <= 8000
                    && request.resource.data.requirements is string
                    && request.resource.data.requirements.size() <= 8000
                    && request.resource.data.deadline is string
                    && request.resource.data.recruiterName is string
                    && request.resource.data.status == 'active'
                    && request.resource.data.applications == 0
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.updatedAt is timestamp
                    && request.resource.data.keys().hasOnly([
                      'recruiterId', 'recruiterPlan', 'recruiterName',
                      'title', 'company', 'location', 'employmentType',
                      'salary', 'description', 'requirements', 'deadline',
                      'status', 'applications', 'featured', 'analyticsEnabled',
                      'createdAt', 'updatedAt'
                    ]);

      // The application and counter update must be committed together.
      // getAfter() confirms that the matching application was created in
      // the same atomic batch, and exists() prevents reusing an old one.
      allow update: if isActiveAccount()
                    && request.auth.uid != resource.data.recruiterId
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['applications', 'lastApplicationId'])
                    && request.resource.data.applications == resource.data.applications + 1
                    && request.resource.data.lastApplicationId is string
                    && !exists(/databases/$(database)/documents/applications/$(request.resource.data.lastApplicationId))
                    && getAfter(/databases/$(database)/documents/applications/$(request.resource.data.lastApplicationId)).data.applicantId == request.auth.uid
                    && getAfter(/databases/$(database)/documents/applications/$(request.resource.data.lastApplicationId)).data.opportunityId == opportunityId
                    && getAfter(/databases/$(database)/documents/applications/$(request.resource.data.lastApplicationId)).data.recruiterId == resource.data.recruiterId;

      allow delete: if false;
    }

    // Applications are private to the applicant and the recruiter who posted
    // the opportunity. Applicants create their own pending applications.
    match /applications/{applicationId} {
      allow get, list: if isActiveAccount()
                       && (resource.data.applicantId == request.auth.uid
                           || resource.data.recruiterId == request.auth.uid);

      allow create: if isActiveAccount()
                    && request.resource.data.applicantId == request.auth.uid
                    && request.resource.data.opportunityId is string
                    && get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.status == 'active'
                    && request.resource.data.recruiterId
                       == get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.recruiterId
                    && request.resource.data.jobTitle
                       == get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.title
                    && request.auth.uid != request.resource.data.recruiterId
                    && request.resource.data.applicantName is string
                    && request.resource.data.applicantEmail is string
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.keys().hasOnly([
                      'opportunityId', 'recruiterId', 'applicantId',
                      'applicantName', 'applicantEmail', 'jobTitle',
                      'status', 'createdAt'
                    ]);

      allow update: if isActiveAccount()
                    && resource.data.recruiterId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in [
                      'Pending', 'Shortlisted', 'Interview', 'Hired', 'Rejected'
                    ];

      allow delete: if false;
    }

    // Stories are visible to signed-in members; members may create only
    // stories attributed to their own authenticated account.
    match /stories/{storyId} {
      allow get, list: if isActiveAccount();
      allow create: if isActiveAccount()
                    && request.resource.data.userId == request.auth.uid
                    // Story badges and paid status must come from the server-controlled profile.
                    && request.resource.data.verified == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('verified', false)
                    && request.resource.data.badgeType == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('badgeType', '')
                    && request.resource.data.premium == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('premium', false)
                    && request.resource.data.premiumTier == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('premiumTier', '')
                    && request.resource.data.role == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user')
                    && request.resource.data.userName is string
                    && request.resource.data.userName.size() <= 100
                    && request.resource.data.storyType in ['text', 'image', 'video']
                    && request.resource.data.storyText is string
                    && request.resource.data.storyText.size() <= 5000
                    && request.resource.data.storyUrl is string
                    && request.resource.data.createdAt is timestamp
                    && (request.resource.data.expiresAt is timestamp
                        || request.resource.data.expiresAt is int)
                    && request.resource.data.views is list
                    && request.resource.data.keys().hasOnly([
                      'userId', 'userName', 'profilePhoto', 'verified',
                      'badgeType', 'verificationMetadata', 'role', 'category',
                      'accessibilityNeeds', 'premium', 'premiumTier',
                      'storyType', 'storyText', 'storyUrl', 'mediaUrl',
                      'mediaType', 'accessibility', 'createdAt', 'expiresAt',
                      'views'
                    ]);
      allow update, delete: if false;
    }

    // Advertising records are owned by the submitting advertiser and moderated by administrators.
    match /advertisements/{advertisementId} {
      allow get: if isActiveAccount()
        && (resource.data.advertiserId == request.auth.uid || isVerifiedAdmin());
      allow list: if isActiveAccount()
        && (isVerifiedAdmin()
            || resource.data.advertiserId == request.auth.uid);
      allow create: if isVerifiedMember()
        && request.resource.data.advertiserId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 5000
        && request.resource.data.type in ['image', 'video', 'text']
        && request.resource.data.budget is number
        && request.resource.data.budget > 0
        && request.resource.data.targeting is map
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'advertiserId','advertiserEmail','title','description','type','budget',
          'targeting','status','impressions','clicks','createdAt','updatedAt'
        ]);
      allow update: if isActiveAccount()
        && (
          (
            resource.data.advertiserId == request.auth.uid
            && request.resource.data.advertiserId == resource.data.advertiserId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title','description','type','budget','targeting','updatedAt'
            ])
          )
          || (
            isVerifiedAdmin()
            && request.resource.data.advertiserId == resource.data.advertiserId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status','reviewedBy','reviewedAt','updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isActiveAccount()
                  && resource.data.receiverId == request.auth.uid;

      allow update: if isActiveAccount()
                    && resource.data.receiverId == request.auth.uid
                    && request.resource.data.receiverId == resource.data.receiverId
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['read']);

      allow create: if isActiveAccount()
                    && request.resource.data.receiverId is string
                    && (
                      request.resource.data.senderId == request.auth.uid
                      || (
                        request.resource.data.senderId == 'system'
                        && request.resource.data.receiverId == request.auth.uid
                      )
                    );

      allow delete: if false;
    }

    // IFSE SOS audit records are written only by the trusted backend.
    // Only administrators or separately designated SOS notification-only monitors may inspect them.
    match /ifseAuditLogs/{logId} {
      allow get, list: if isActiveAccount()
                      && (isVerifiedAdmin()
                          || request.auth.token.sosNotificationOnly == true);
      allow create, update, delete: if false;
    }

    // Emergency requests are private to their creator.
    // Client accounts may submit and view their own SOS records, but cannot
    // change dispatch decisions, responder assignments, or case outcomes.
    match /emergencySOS/{emergencyId} {
      function ownsRequest() {
        return isActiveAccount() && resource.data.userId == request.auth.uid;
      }
      allow get, list: if ownsRequest();
      allow create: if isActiveAccount()
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.systemPlaceholder == false
                    && request.resource.data.handledBy == ''
                    && request.resource.data.assignedResponder == ''
                    && request.resource.data.assignedResponderId == ''
                    && request.resource.data.assignedAgency == ''
                    && request.resource.data.assignedAgencyCode == ''
                    && request.resource.data.assignedAgencyType == ''
                    && request.resource.data.incidentStatus == 'Active'
                    && request.resource.data.assignedStation == ''
                    && request.resource.data.assignedVehicle == ''
                    && request.resource.data.estimatedArrival == ''
                    && request.resource.data.responseStatus == 'Awaiting Response'
                    && request.resource.data.assignmentStatus == 'Pending'
                    && request.resource.data.ifseThreatScore == 0
                    && request.resource.data.ifseClassification == 'Pending'
                    && request.resource.data.resolvedBy == ''
                    && request.resource.data.resolutionNotes == ''
                    && request.resource.data.closedAt == null
                    && request.resource.data.emergencyType is string
                    && request.resource.data.priority in ['Low', 'Medium', 'High', 'Critical']
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 5000
                    && request.resource.data.location is string
                    && request.resource.data.latitude is string
                    && request.resource.data.longitude is string
                    && request.resource.data.accuracy is string
                    && request.resource.data.status == 'open'
                    && request.resource.data.resolved == false
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.updatedAt is timestamp
                    && request.resource.data.lastUpdated is timestamp
                    && request.resource.data.keys().hasOnly([
                      'systemPlaceholder', 'userId', 'userName', 'userPhoto',
                      'emergencyType', 'priority', 'description', 'location',
                      'latitude', 'longitude', 'accuracy', 'locationSource',
                      'locationCapturedAt', 'gpsLatitude', 'gpsLongitude',
                      'trustedContact', 'responderNotes', 'status', 'handledBy',
                      'resolved', 'assignedResponder', 'assignedResponderId',
                      'assignedAgency', 'assignedAgencyCode', 'assignedAgencyType',
                      'incidentStatus', 'incidentNumber', 'assignedStation',
                      'assignedVehicle', 'estimatedArrival', 'responseStatus',
                      'assignmentStatus', 'ifseThreatScore', 'ifseClassification',
                      'resolvedBy', 'resolutionNotes', 'closedAt', 'createdAt',
                      'updatedAt', 'lastUpdated'
                    ]);
      allow update, delete: if false;
    }

    // SOS readiness stores permission status only, never coordinates.
    // Each member can read and maintain only their own readiness record.
    match /sosReadiness/{userId} {
      function isOwner() {
        return isActiveAccount() && request.auth.uid == userId;
      }
      function validReadiness() {
        return request.resource.data.userId == userId
          && request.resource.data.locationVerified is bool
          && request.resource.data.locationPermission in [
            'granted', 'denied', 'unavailable', 'unknown'
          ]
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.keys().hasOnly([
            'userId', 'locationVerified', 'locationPermission',
            'verifiedAt', 'updatedAt'
          ])
          && (!('verifiedAt' in request.resource.data)
              || request.resource.data.verifiedAt is timestamp);
      }
      allow get: if isOwner();
      allow list: if false;
      allow create: if isOwner() && validReadiness();
      allow update: if isOwner()
                    && resource.data.userId == userId
                    && validReadiness()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly([
                         'locationVerified', 'locationPermission',
                         'verifiedAt', 'updatedAt'
                       ]);
      allow delete: if false;
    }

    // Trusted contacts are private to the member who created them.
    match /trustedContacts/{contactId} {
      function ownsContact() {
        return isActiveAccount() && resource.data.userId == request.auth.uid;
      }
      function validContact(data) {
        return data.userId == request.auth.uid
          && data.ownerId == request.auth.uid
          && data.fullName is string
          && data.fullName.size() > 0
          && data.fullName.size() <= 100
          && data.relationship is string
          && data.relationship.size() <= 60
          && data.phoneNumber is string
          && data.phoneNumber.size() <= 40
          && data.email is string
          && data.email.size() <= 160
          && (data.phoneNumber.size() > 0 || data.email.size() > 0)
          && data.status == 'Active';
      }
      allow get, list: if ownsContact();
      allow create: if isActiveAccount()
                    && validContact(request.resource.data)
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.updatedAt is timestamp
                    && request.resource.data.keys().hasOnly([
                      'userId', 'ownerId', 'fullName', 'relationship',
                      'phoneNumber', 'email', 'status', 'createdAt', 'updatedAt'
                    ]);
      allow update: if ownsContact()
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.ownerId == resource.data.ownerId
                    && validContact(request.resource.data)
                    && request.resource.data.updatedAt is timestamp
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['fullName', 'relationship', 'phoneNumber', 'email', 'status', 'updatedAt']);
      allow delete: if ownsContact();
    }

    // Inclura does not operate user wallets or store-value balances.
    // Legacy wallet records, if any, are inaccessible to client applications.
    match /walletAccounts/{userId} {
      allow read, write: if false;
    }

    match /walletTransactions/{transactionId} {
      allow read, write: if false;
    }

    // Verification applications and supporting records are private to the applicant.
    function ownsVerification(verificationId) {
      return isActiveAccount()
        && exists(/databases/$(database)/documents/verificationRequests/$(verificationId))
        && (
          get(/databases/$(database)/documents/verificationRequests/$(verificationId)).data.userId == request.auth.uid
          || get(/databases/$(database)/documents/verificationRequests/$(verificationId)).data.submittedBy == request.auth.uid
        );
    }

    function ownsPartnership(partnershipId) {
      return isActiveAccount() && (
        (
          exists(/databases/$(database)/documents/enterprisePartnerships/$(partnershipId))
          && get(/databases/$(database)/documents/enterprisePartnerships/$(partnershipId)).data.userId == request.auth.uid
        )
        || (
          exists(/databases/$(database)/documents/corporatePartnerships/$(partnershipId))
          && get(/databases/$(database)/documents/corporatePartnerships/$(partnershipId)).data.userId == request.auth.uid
        )
        || (
          exists(/databases/$(database)/documents/governmentPartnerships/$(partnershipId))
          && get(/databases/$(database)/documents/governmentPartnerships/$(partnershipId)).data.userId == request.auth.uid
        )
      );
    }

    function ownsPayment(paymentId) {
      return isActiveAccount()
        && exists(/databases/$(database)/documents/verificationPayments/$(paymentId))
        && get(/databases/$(database)/documents/verificationPayments/$(paymentId)).data.userId == request.auth.uid;
    }


    // Published plan prices are readable by signed-in members. Only accounts
    // carrying the server-issued administrator claim may manage pricing.
    match /pricing/{pricingId} {
      allow get, list: if isActiveAccount();
      allow create, update, delete: if isActiveAccount()
        && isVerifiedAdmin();
    }

    match /enterprisePartnerships/{partnershipId} {
      allow create: if isActiveAccount()
        && hasNoServerManagedPartnershipFields()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.organizationName is string
        && request.resource.data.contactEmail is string
        && request.resource.data.requestStatus == 'submitted'
        && request.resource.data.reviewProgress.application == true
        && request.resource.data.reviewProgress.security == false
        && request.resource.data.reviewProgress.accessibility == false
        && request.resource.data.reviewProgress.compliance == false
        && request.resource.data.reviewProgress.integration == false
        && request.resource.data.reviewProgress.approval == false
        && request.resource.data.timeline is list
        && request.resource.data.timeline.size() == 5
        && request.resource.data.timeline[0].title == 'Application Started'
        && request.resource.data.timeline[0].status == 'Completed'
        && request.resource.data.timeline[1].title == 'Enterprise Security Review'
        && request.resource.data.timeline[1].status == 'Pending'
        && request.resource.data.timeline[2].title == 'Accessibility Review'
        && request.resource.data.timeline[2].status == 'Pending'
        && request.resource.data.timeline[3].title == 'Compliance Review'
        && request.resource.data.timeline[3].status == 'Pending'
        && request.resource.data.timeline[4].title == 'Enterprise Approval'
        && request.resource.data.timeline[4].status == 'Pending'
        && request.resource.data.enterpriseStatus == 'Pending'
        && request.resource.data.verificationStatus == 'Awaiting IFSE Review'
        && request.resource.data.approvalStatus == 'Not Approved'
        && request.resource.data.contractStatus == 'Inactive'
        && request.resource.data.createdAt is timestamp;
      allow get, list: if isActiveAccount()
        && (isVerifiedAdmin() || resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    match /corporatePartnerships/{partnershipId} {
      allow create: if isActiveAccount()
        && hasNoServerManagedPartnershipFields()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.companyName is string
        && request.resource.data.contactEmail is string
        && request.resource.data.requestStatus == 'submitted'
        && request.resource.data.reviewProgress.application == true
        && request.resource.data.reviewProgress.security == false
        && request.resource.data.reviewProgress.compliance == false
        && request.resource.data.reviewProgress.accessibility == false
        && request.resource.data.reviewProgress.approval == false
        && request.resource.data.timeline is list
        && request.resource.data.timeline.size() == 5
        && request.resource.data.timeline[0].title == 'Application Submitted'
        && request.resource.data.timeline[0].status == 'Completed'
        && request.resource.data.timeline[1].title == 'Corporate Security Review'
        && request.resource.data.timeline[1].status == 'Pending'
        && request.resource.data.timeline[2].title == 'Accessibility Review'
        && request.resource.data.timeline[2].status == 'Pending'
        && request.resource.data.timeline[3].title == 'Compliance Review'
        && request.resource.data.timeline[3].status == 'Pending'
        && request.resource.data.timeline[4].title == 'Corporate Approval'
        && request.resource.data.timeline[4].status == 'Pending'
        && request.resource.data.verificationStatus == 'Awaiting IFSE Review'
        && request.resource.data.approvalStatus == 'Not Approved'
        && request.resource.data.contractStatus == 'Inactive'
        && request.resource.data.createdAt is timestamp;
      allow get, list: if isActiveAccount()
        && (isVerifiedAdmin() || resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    match /governmentPartnerships/{partnershipId} {
      allow create: if isActiveAccount()
        && hasNoServerManagedPartnershipFields()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.agencyName is string
        && request.resource.data.officialEmail is string
        && request.resource.data.status == 'submitted'
        && request.resource.data.approvalStatus == 'Not Approved'
        && request.resource.data.contractStatus == 'Inactive'
        && request.resource.data.reviewProgress.application == true
        && request.resource.data.reviewProgress.identityReview == false
        && request.resource.data.reviewProgress.securityReview == false
        && request.resource.data.reviewProgress.accessibilityReview == false
        && request.resource.data.reviewProgress.complianceReview == false
        && request.resource.data.reviewProgress.executiveApproval == false
        && request.resource.data.timeline is list
        && request.resource.data.timeline.size() == 6
        && request.resource.data.timeline[0].title == 'Application Started'
        && request.resource.data.timeline[0].status == 'Completed'
        && request.resource.data.timeline[1].title == 'Government Identity Review'
        && request.resource.data.timeline[1].status == 'Pending'
        && request.resource.data.timeline[2].title == 'IFSE Security Review'
        && request.resource.data.timeline[2].status == 'Pending'
        && request.resource.data.timeline[3].title == 'Accessibility Compliance'
        && request.resource.data.timeline[3].status == 'Pending'
        && request.resource.data.timeline[4].title == 'Compliance Review'
        && request.resource.data.timeline[4].status == 'Pending'
        && request.resource.data.timeline[5].title == 'Executive Approval'
        && request.resource.data.timeline[5].status == 'Pending'
        && request.resource.data.createdAt is timestamp;
      allow get, list: if isActiveAccount()
        && (isVerifiedAdmin() || resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    match /enterpriseTimeline/{entryId} {
      allow create: if isActiveAccount()
        && request.resource.data.partnershipId is string
        && ownsPartnership(request.resource.data.partnershipId)
        && (
          (
            request.resource.data.title == 'Application Submitted'
            && request.resource.data.status == 'Completed'
          )
          || (
            request.resource.data.title in [
              'Security Review', 'Accessibility Review', 'Compliance Review',
              'Executive Approval', 'Activation'
            ]
            && request.resource.data.status == 'Pending'
          )
        )
        && request.resource.data.createdAt is timestamp;
      allow get, list: if isActiveAccount()
        && (isVerifiedAdmin()
            || ownsPartnership(resource.data.partnershipId));
      allow update, delete: if false;
    }

    match /corporateTimeline/{entryId} {
      allow create: if isActiveAccount()
        && request.resource.data.partnershipId is string
        && ownsPartnership(request.resource.data.partnershipId)
        && request.resource.data.partnershipType == 'corporate'
        && (
          (
            request.resource.data.title == 'Application Submitted'
            && request.resource.data.status == 'Completed'
          )
          || (
            request.resource.data.title in [
              'Security Review', 'Accessibility Review', 'Compliance Review',
              'Executive Approval', 'Activation'
            ]
            && request.resource.data.status == 'Pending'
          )
        )
        && request.resource.data.createdAt is timestamp;
      allow get, list: if isActiveAccount()
        && (isVerifiedAdmin()
            || ownsPartnership(resource.data.partnershipId));
      allow update, delete: if false;
    }

    match /verificationRequests/{verificationId} {
      allow create: if isActiveAccount()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.category is string
        && request.resource.data.verificationType is string
        && request.resource.data.fullName is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.paymentAmount is number
        && request.resource.data.paymentAmount > 0
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        // Client submissions cannot claim server screening, document approval or risk clearance.
        && request.resource.data.ifseScore == null
        && request.resource.data.ifseScoreSource == 'not_server_verified'
        && request.resource.data.ifseStatus == 'PENDING_SERVER_REVIEW'
        && request.resource.data.ifseBadge == false
        && request.resource.data.executiveReview == true
        && request.resource.data.riskScore == null
        && request.resource.data.riskScoreSource == 'not_server_verified'
        && request.resource.data.threatLevel == 'UNASSESSED'
        && request.resource.data.executiveReviewRequired == true
        && request.resource.data.documentUrl == ''
        && request.resource.data.documentVerified == false
        && request.resource.data.accountType == request.resource.data.category
        && request.resource.data.keys().hasOnly([
          'userId', 'submittedBy', 'category', 'verificationType',
          'accountType', 'fullName', 'email', 'phone', 'organizationName',
          'website', 'socialLink1', 'socialLink2', 'officialEmail',
          'paymentAmount', 'paymentStatus', 'status', 'ifseScore',
          'ifseScoreSource', 'ifseStatus', 'ifseMessage', 'ifseBadge',
          'executiveReview', 'riskScore', 'riskScoreSource', 'threatLevel',
          'executiveReviewRequired', 'enterprise', 'documentUrl',
          'documentVerified', 'note', 'createdAt', 'updatedAt'
        ]);

      allow get, list: if isActiveAccount()
        && (isVerifiedAdmin()
            || resource.data.userId == request.auth.uid
            || resource.data.submittedBy == request.auth.uid);

      allow update: if isActiveAccount()
        && (resource.data.userId == request.auth.uid
            || resource.data.submittedBy == request.auth.uid)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.submittedBy == resource.data.submittedBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'verificationType', 'organizationName', 'contactName', 'contactEmail',
          'country', 'state', 'city', 'notes', 'accessibilityNeeds', 'uploadedDocuments',
          'documentsSubmitted', 'documentSubmissionStatus', 'status', 'updatedAt'
        ])
        && request.resource.data.status in ['pending', 'under_review']
        && request.resource.data.get('paymentStatus', 'pending') == resource.data.get('paymentStatus', 'pending')
        && request.resource.data.get('paymentId', null) == resource.data.get('paymentId', null)
        && request.resource.data.paymentAmount == resource.data.paymentAmount
        && (resource.data.get('paymentStatus', 'pending') != 'paid'
            || request.resource.data.verificationType == resource.data.verificationType);

      allow delete: if false;
    }

    match /verificationTimeline/{entryId} {
      allow create: if isActiveAccount()
        && request.resource.data.verificationId is string
        && ownsVerification(request.resource.data.verificationId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title in [
          'Application Submitted', 'Verification Documents Submitted'
        ]
        && request.resource.data.status == 'Completed'
        && request.resource.data.description is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly([
          'verificationId', 'title', 'status', 'description',
          'createdBy', 'createdAt'
        ]);
      allow get, list: if isActiveAccount()
        && (isVerifiedAdmin()
            || ownsVerification(resource.data.verificationId));
      allow update, delete: if false;
    }

    match /verificationDocuments/{documentId} {
      allow create: if isActiveAccount()
        && request.resource.data.verificationId is string
        && request.resource.data.submittedBy == request.auth.uid
        && ownsVerification(request.resource.data.verificationId)
        && request.resource.data.verificationType is string
        && request.resource.data.documentCategory is string
        && request.resource.data.uploadedDocuments is map
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly([
          'verificationId', 'verificationType', 'documentCategory',
          'uploadedDocuments', 'submittedBy', 'createdAt'
        ]);
      allow get, list: if isActiveAccount()
        && (isVerifiedAdmin()
            || ownsVerification(resource.data.verificationId));
      allow update, delete: if false;
    }

    match /creatorVerificationAuditLogs/{logId} {
      allow get, list: if isActiveAccount()
        && (isVerifiedAdmin() || resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /verificationAuditLogs/{logId} {
      allow create: if isActiveAccount()
        && (request.resource.data.performedBy == request.auth.uid
            || request.resource.data.actor == request.auth.uid)
        && request.resource.data.verificationId is string
        && (
          (
            request.resource.data.action in [
              'Verification application submitted', 'Verification Documents Submitted'
            ]
            && ownsVerification(request.resource.data.verificationId)
          )
          || (
            request.resource.data.action == 'Government Partnership Submitted'
            && ownsPartnership(request.resource.data.verificationId)
          )
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly([
          'verificationId', 'action', 'performedBy', 'actor',
          'category', 'verificationType', 'createdAt'
        ]);
      allow get, list: if isActiveAccount()
        && (isVerifiedAdmin()
            || ownsVerification(resource.data.verificationId)
            || ownsPartnership(resource.data.verificationId));
      allow update, delete: if false;
    }

    match /ifseSecurityEvents/{eventId} {
      allow create: if isActiveAccount()
        && (
          (
            request.resource.data.verificationId is string
            && request.resource.data.eventType in ['Application Received', 'documents_submitted']
            && ownsVerification(request.resource.data.verificationId)
          )
          || (
            request.resource.data.userId == request.auth.uid
            && request.resource.data.partnershipId is string
            && request.resource.data.source == 'member_submission'
            && request.resource.data.eventType in [
              'government_partnership_created', 'corporate_partnership_created'
            ]
            && ownsPartnership(request.resource.data.partnershipId)
          )
          || (
            request.resource.data.userId == request.auth.uid
            && request.resource.data.source == 'member_submission'
            && request.resource.data.eventType in [
              'duplicate_organization', 'duplicate_contact_email', 'duplicate_company'
            ]
          )
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly([
          'verificationId', 'eventType', 'assessmentStatus', 'resolved',
          'verificationType', 'documentCategory', 'reviewed',
          'partnershipId', 'userId', 'source', 'createdAt',
          'partnershipType', 'contactEmail', 'companyName',
          'organizationName', 'severity', 'automaticAssessment',
          'requiresManualReview'
        ]);
      allow get, list: if isActiveAccount()
        && (
          isVerifiedAdmin()
          || resource.data.get('userId', null) == request.auth.uid
          || (
            resource.data.get('verificationId', null) is string
            && ownsVerification(resource.data.verificationId)
          )
          || (
            resource.data.get('partnershipId', null) is string
            && ownsPartnership(resource.data.partnershipId)
          )
          || (
            resource.data.get('paymentId', null) is string
            && ownsPayment(resource.data.paymentId)
          )
        );
      allow update: if isActiveAccount()
        && isVerifiedAdmin()
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'reviewed', 'reviewedAt', 'reviewedBy'
            ])
            && request.resource.data.reviewed == true
            && request.resource.data.reviewedBy == request.auth.uid
            && request.resource.data.reviewedAt is timestamp
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'resolved', 'resolvedAt', 'resolvedBy'
            ])
            && request.resource.data.resolved == true
            && request.resource.data.resolvedBy == request.auth.uid
            && request.resource.data.resolvedAt is timestamp
          )
        );
      allow delete: if false;
    }

    // Checkout intents and webhook reconciliation records are backend-only.
    // A browser must never create, read, or modify pending gateway transactions.
    match /flutterwavePendingPayments/{pendingId} {
      allow read, write: if false;
    }

    // Payment records are visible only to the member who paid.
    match /verificationPayments/{paymentId} {
      // Only the trusted IFSE backend may create payment confirmations.
      // Browser clients cannot self-assert a successful gateway payment.
      allow create: if false;
      allow get, list: if isActiveAccount()
        && (isVerifiedAdmin()
            || resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    match /ifsePaymentEvents/{eventId} {
      // IFSE creates payment-security events after gateway verification.
      allow create: if false;
      allow get, list: if isActiveAccount()
        && (isVerifiedAdmin()
            || ownsPayment(resource.data.paymentId));
      allow update, delete: if false;
    }

    match /paymentAuditLogs/{logId} {
      // Audit records are server-generated and immutable to browser clients.
      allow create: if false;
      allow get, list: if isActiveAccount()
        && (isVerifiedAdmin()
            || ownsPayment(resource.data.paymentId));
      allow update, delete: if false;
    }

    match /paymentTimeline/{entryId} {
      // Payment timeline entries are written by the trusted backend.
      allow create: if false;
      allow get, list: if isActiveAccount()
        && (isVerifiedAdmin()
            || ownsPayment(resource.data.paymentId));
      allow update, delete: if false;
    }


    match /communityAlertDevices/{guestUid} {
      function isOwnAnonymousGuest() {
        return isActiveAccount()
          && request.auth.uid == guestUid
          && request.auth.token.firebase.sign_in_provider == 'anonymous';
      }
      function validCommunityAlertDevice() {
        return request.resource.data.uid == guestUid
          && request.resource.data.token is string
          && request.resource.data.token.size() > 20
          && request.resource.data.platform == 'web'
          && request.resource.data.enabled == true
          && request.resource.data.area is string
          && request.resource.data.area.size() >= 3
          && request.resource.data.area.size() <= 100
          && request.resource.data.areaNormalized is string
          && request.resource.data.areaNormalized.size() >= 2
          && request.resource.data.areaNormalized.size() <= 100
          && request.resource.data.localityNormalized is string
          && request.resource.data.localityNormalized.size() >= 3
          && request.resource.data.localityNormalized.size() <= 100
          && request.resource.data.consent == true
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.keys().hasOnly([
            'uid', 'token', 'platform', 'enabled', 'area',
            'areaNormalized', 'localityNormalized', 'consent', 'createdAt', 'updatedAt'
          ]);
      }
      allow get: if isOwnAnonymousGuest();
      allow list: if false;
      allow create: if isOwnAnonymousGuest() && validCommunityAlertDevice();
      allow update: if isOwnAnonymousGuest()
        && resource.data.uid == guestUid
        && validCommunityAlertDevice()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'token', 'enabled', 'area', 'areaNormalized', 'localityNormalized', 'consent', 'updatedAt'
        ]);
      allow delete: if isOwnAnonymousGuest()
        && resource.data.uid == guestUid;
    }

    // A member can register and manage only their own FCM device tokens.
    // The backend uses Firebase Admin to read tokens for automatic SOS alerts.

    // A member can register and manage only their own FCM device tokens.
    // The backend uses Firebase Admin to read tokens for automatic SOS alerts.
    match /fcmTokens/{tokenId} {
      function ownsToken() {
        return isActiveAccount() && resource.data.userId == request.auth.uid;
      }
      allow get, list: if ownsToken();
      allow create: if isActiveAccount()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() > 20
        && request.resource.data.platform == 'web'
        && request.resource.data.enabled == true
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'userId', 'token', 'platform', 'enabled', 'createdAt', 'updatedAt'
        ]);
      allow update: if ownsToken()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.token == resource.data.token
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['enabled', 'updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.updatedAt is timestamp;
      allow delete: if ownsToken();
    }

  }
}
